# --- Backend Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Feature 01: Local Upload Storage ---
UPLOAD_STORAGE_DIR=backend/storage/uploads
MAX_FILE_SIZE_MB=20
MAX_BATCH_FILES=3
MAX_BATCH_SIZE_MB=60

# --- Feature 02: Local Multimodal Extraction (Docling + Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TEMPERATURE=0.0
OLLAMA_TIMEOUT_SECONDS=120
EXTRACTION_MAX_CHUNK_CHARS=6000
EXTRACTED_STORAGE_DIR=backend/storage/extracted
METADATA_STORAGE_PATH=backend/storage/metadata.json

# --- Feature 03: Neo4j Knowledge Graph ---
NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j
NEO4J_AUTO_SYNC=true
NEO4J_TIMEOUT_SECONDS=30